# The server admin's part around Liquibase (apps/Sso.DbMigrator, ADR 0004): prepare before Liquibase, finish after
# it - for a deployment where neither the .NET SDK nor deploy/deploy.sh is at hand.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ENV HUSKY=0
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props nuget.config ./
COPY apps/Sso.DbMigrator/Sso.DbMigrator.csproj apps/Sso.DbMigrator/
RUN dotnet restore apps/Sso.DbMigrator/Sso.DbMigrator.csproj
COPY apps/Sso.DbMigrator/ apps/Sso.DbMigrator/
RUN dotnet publish apps/Sso.DbMigrator/Sso.DbMigrator.csproj --configuration Release --no-restore \
    --output /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "Sso.DbMigrator.dll"]
