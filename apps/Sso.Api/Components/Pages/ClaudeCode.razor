@page "/admin/claude-code"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@using System.Security.Cryptography
@using Microsoft.Extensions.Options
@using Sso.Api.Mcp
@using Sso.Api.Oidc
@using McpTokensApi = Sso.ApiClient.Generated.Api.Platform.McpTokens
@inject SsoApi Api
@inject NavigationManager Navigation
@inject IOptions<OidcOptions> Oidc

<PageTitle>Claude Code · Great SSO</PageTitle>

<PageHeader Eyebrow="SSO" Title="Claude Code (MCP)"
            Description="Claude Code can run everything this panel does - people, applications, the log - through MCP, as you. A token is yours alone, shown once, and stops when you revoke it, when it expires, or when you are no longer an SSO admin. Every call is in the log.">
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="OpenIssue"><Icon Name="key-round" Class="size-4" /> New token</button>
    </Actions>
</PageHeader>

<ErrorAlert Message="@_error" />

@if (_rows is { Count: 0 })
{
    <EmptyState IconName="key-round" Title="No token yet" Description="Make one to connect Claude Code to Great SSO." />
}
else if (_rows is not null)
{
    <div class="card overflow-x-auto">
        <table class="table">
            <thead><tr><th>Name</th><th>Made</th><th>Expires</th><th>Last used</th><th>State</th><th></th></tr></thead>
            <tbody>
                @foreach (var token in _rows)
                {
                    <tr>
                        <td class="font-medium">@token.Name</td>
                        <td class="whitespace-nowrap text-muted-foreground">@Labels.DateTime(token.CreatedAt)</td>
                        <td class="whitespace-nowrap text-muted-foreground">@Labels.DateTime(token.ExpiresAt)</td>
                        <td class="whitespace-nowrap text-muted-foreground">@(token.LastUsedAt is null ? "never" : Labels.DateTime(token.LastUsedAt))</td>
                        <td><span class="@(token.State == "active" ? "badge badge-success" : "badge badge-secondary")">@token.State</span></td>
                        <td class="text-right">
                            @if (token.State == "active")
                            {
                                <button type="button" class="btn btn-outline btn-sm" disabled="@_saving" @onclick="() => RevokeAsync(token.Id!.Value)">Revoke</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_issue is not null)
{
    <Modal Title="New MCP token" Description="Name it after where it is used; it opens the SSO panel's operations as you." OnClose="() => _issue = null">
        <EditForm Model="_issue" OnSubmit="IssueAsync" FormName="mcp-token" class="space-y-4">
            <ErrorAlert Message="@_issueError" />
            <div class="space-y-1.5">
                <label class="label" for="t-name">Name</label>
                <InputText id="t-name" class="input" @bind-Value="_issue.Name" placeholder="Laptop - Claude Code" />
            </div>
            <div class="space-y-1.5">
                <label class="label" for="t-days">Valid for (days)</label>
                <InputNumber id="t-days" class="input" @bind-Value="_issue.Days" min="1" max="365" />
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" class="btn btn-outline" @onclick="() => _issue = null">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@_saving">Make the token</button>
            </div>
        </EditForm>
    </Modal>
}

@if (_shown is not null)
{
    <Modal Title="Connect Claude Code" Description="The token is shown once - Great SSO keeps only its hash. Run this in a terminal:" OnClose="() => _shown = null">
        <div class="space-y-4">
            <pre class="rounded-lg bg-muted p-3 font-mono text-xs break-all whitespace-pre-wrap" data-testid="mcp-command">claude mcp add --transport http great-sso @(Oidc.Value.Issuer)@(McpSetup.Path) --header "Authorization: Bearer @_shown"</pre>
            <p class="text-xs text-muted-foreground">Keep it out of repositories and shared notes. Revoke it here when the machine is no longer yours.</p>
            <div class="flex justify-end">
                <button type="button" class="btn btn-primary" @onclick="() => _shown = null">I have copied it</button>
            </div>
        </div>
    </Modal>
}

@code {
    private sealed class IssueForm
    {
        // The id comes from the page (ADR 0006); the token too - the database only ever sees its hash.
        public Guid Id { get; } = Guid.CreateVersion7();
        public string Name { get; set; } = "Laptop - Claude Code";
        public int Days { get; set; } = 90;
        public string Token { get; } = McpTokenHandler.Prefix + Secrets.NewToken();
    }

    private List<PlatformMcpTokensRow>? _rows;
    private string? _error;
    private IssueForm? _issue;
    private string? _issueError;
    private string? _shown;
    private bool _saving;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _rows = (await Api.Api.Platform.McpTokens.GetAsync(r =>
            {
                r.QueryParameters.Sort = McpTokensApi.GetSortQueryParameterType.CreatedAt;
                r.QueryParameters.Desc = true;
            }))?.Items ?? [];
        }
        catch (Exception ex)
        {
            if (ApiErrors.IsSessionExpired(ex))
                Navigation.NavigateTo("auth/session-expired?returnUrl=%2Fadmin%2Fclaude-code", forceLoad: true);
            _error = ApiErrors.Describe(ex);
        }
    }

    private void OpenIssue()
    {
        _issue = new IssueForm();
        _issueError = null;
    }

    private async Task IssueAsync()
    {
        if (_issue is null)
            return;
        var issue = _issue;
        _saving = true;
        _issueError = null;
        try
        {
            await Api.Api.Platform.McpTokenIssue.PostAsync(new PlatformMcpTokenIssueRequest
            {
                Id = issue.Id,
                Name = issue.Name,
                TokenHash = Convert.ToHexStringLower(SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(issue.Token))),
                ValidDays = issue.Days,
            });
            _issue = null;
            _shown = issue.Token;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (ApiErrors.IsSessionExpired(ex))
                Navigation.NavigateTo("auth/session-expired?returnUrl=%2Fadmin%2Fclaude-code", forceLoad: true);
            _issueError = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevokeAsync(Guid id)
    {
        _saving = true;
        try
        {
            await Api.Api.Platform.McpTokenRevoke.PostAsync(new PlatformMcpTokenRevokeRequest { Id = id });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (ApiErrors.IsSessionExpired(ex))
                Navigation.NavigateTo("auth/session-expired?returnUrl=%2Fadmin%2Fclaude-code", forceLoad: true);
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }
}
