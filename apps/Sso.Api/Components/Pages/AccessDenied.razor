@page "/access-denied"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]
@inject AuthenticationStateProvider Auth

<PageTitle>Signed in · Great SSO</PageTitle>

@* A member (not an SSO admin) who opens SSO itself: signed in, but the panel is not theirs. *@
<div class="w-full max-w-md space-y-6">
    <div class="flex flex-col items-center gap-4 text-center">
        <BrandMark TextClass="text-foreground" />
    </div>
    <div class="card space-y-3 p-6">
        <div class="flex items-start gap-3">
            <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-success/15 text-success">
                <Icon Name="shield-check" Class="size-4.5" />
            </span>
            <div class="space-y-1.5">
                <h1 class="text-lg font-semibold">You are signed in to Great SSO@(_name is null ? "" : $", {_name}")</h1>
                <p class="text-sm text-muted-foreground">
                    The SSO panel is only for SSO admins. Open the application you want to use - it signs you in through
                    SSO by itself.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _name;

    protected override async Task OnInitializedAsync() =>
        _name = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name;
}
