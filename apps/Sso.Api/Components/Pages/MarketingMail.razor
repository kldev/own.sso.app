@page "/admin/marketing/mail"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using Microsoft.Extensions.Options
@using Sso.Api.Marketing
@using MailingsApi = Sso.ApiClient.Generated.Api.Marketing.Mailings
@using RecipientsApi = Sso.ApiClient.Generated.Api.Marketing.Recipients
@using TemplatesApi = Sso.ApiClient.Generated.Api.Marketing.Templates
@inject SsoApi Api
@inject NavigationManager Navigation
@inject IOptions<SmtpOptions> Smtp

<PageTitle>Mail · Marketing · Great SSO</PageTitle>

<PageHeader Eyebrow="Marketing" Title="Mail"
            Description="Send a product's e-mail to a list of addresses. Every address gets its own e-mail - nobody sees the others." />

@if (!Smtp.Value.Enabled)
{
    <div class="card mb-5 flex items-start gap-3 border-warning/40 bg-warning/10 p-4 text-sm" role="status">
        <Icon Name="triangle-alert" Class="mt-0.5 size-4 shrink-0" />
        <p>Sending is off: <span class="font-mono">Smtp__Host</span> is not set on this host. Mailings are kept and go out once it is.</p>
    </div>
}

<ErrorAlert Message="@_error" />

@if (_templates is null && _error is null)
{
    <div class="h-64 animate-pulse rounded-xl bg-muted"></div>
}
else if (_templates is not null)
{
    <section class="card mb-6 space-y-5 p-5" aria-labelledby="new-mailing">
        <h2 id="new-mailing" class="text-base font-semibold">New mailing</h2>

        <fieldset>
            <legend class="label mb-2">Template</legend>
            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var template in _templates)
                {
                    var t = template;
                    <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border px-3 py-2.5 text-sm has-checked:border-primary has-checked:bg-primary/5"
                           data-template="@t.Code">
                        <span class="flex items-center gap-2">
                            <input type="radio" name="template" checked="@(_selected?.Id == t.Id)" @onchange="() => Choose(t)" />
                            <span class="font-medium">@ProductName(t.Product)</span>
                            <span class="badge badge-outline ml-auto uppercase">@t.Language</span>
                        </span>
                        <span class="truncate text-xs text-muted-foreground" title="@t.Subject">@t.Subject</span>
                    </label>
                }
            </div>
        </fieldset>

        @if (_selected is not null)
        {
            <div class="space-y-1.5">
                <label class="label" for="m-subject">Subject</label>
                <input id="m-subject" class="input" @bind="_subject" @bind:event="oninput" maxlength="200" />
            </div>
            <div class="space-y-1.5">
                <div class="flex flex-wrap items-end justify-between gap-2">
                    <label class="label" for="m-body">Text - plain text, sent as it is</label>
                    <div class="flex gap-2">
                        @if (Edited)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => Choose(_selected)">Back to the template</button>
                            <button type="button" class="btn btn-outline btn-sm" disabled="@_busy" @onclick="SaveTemplateAsync">
                                <Icon Name="pencil" Class="size-4" /> Save as the template
                            </button>
                        }
                    </div>
                </div>
                <textarea id="m-body" class="input min-h-80 font-sans text-sm leading-relaxed" @bind="_body" @bind:event="oninput"></textarea>
            </div>

            <div class="space-y-1.5">
                <label class="label" for="m-emails">Addresses - one per line, or separated by commas, semicolons or spaces</label>
                <textarea id="m-emails" class="input min-h-32 font-mono text-xs" @bind="_emails" @bind:event="oninput"
                          placeholder="@AddressesExample" autocomplete="off" autocapitalize="none" spellcheck="false"></textarea>
                <p class="text-xs text-muted-foreground" data-testid="address-count">
                    @Addresses.Count @(Addresses.Count == 1 ? "address" : "addresses")@(Duplicates > 0 ? $" ({Duplicates} repeated, sent once)" : "")
                    @if (Invalid.Count > 0)
                    {
                        <span class="text-destructive"> · not an address: @string.Join(", ", Invalid)</span>
                    }
                </p>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="_skipContacted" />
                Skip addresses that already got an e-mail about @ProductName(_selected.Product)
            </label>

            <ErrorAlert Message="@_formError" />
            @if (_notice is not null)
            {
                <p class="rounded-lg bg-success/10 px-3 py-2 text-sm" role="status" data-testid="notice">@_notice</p>
            }

            <div class="flex justify-end">
                <button type="button" class="btn btn-primary" disabled="@(_busy || Addresses.Count == 0 || Invalid.Count > 0)" @onclick="() => _confirm = true">
                    <Icon Name="mail" Class="size-4" /> Send @Addresses.Count @(Addresses.Count == 1 ? "e-mail" : "e-mails")
                </button>
            </div>
        }
    </section>

    <section aria-labelledby="mailings">
        <div class="mb-3 flex items-center justify-between">
            <h2 id="mailings" class="text-base font-semibold">Mailings</h2>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadMailingsAsync"><Icon Name="refresh-cw" Class="size-4" /> Refresh</button>
        </div>
        @if (_mailings is { Count: 0 })
        {
            <EmptyState IconName="mail" Title="No mailing yet" Description="Choose a template, paste the addresses and send." />
        }
        else if (_mailings is not null)
        {
            <div class="card overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr><th>Sent</th><th>Template</th><th>Subject</th><th>Progress</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _mailings)
                        {
                            var mailing = m;
                            <tr data-mailing-id="@m.Id">
                                <td class="whitespace-nowrap">
                                    <p>@Labels.DateTime(m.CreatedAt)</p>
                                    <p class="text-xs text-muted-foreground">@m.CreatedByName</p>
                                </td>
                                <td class="whitespace-nowrap">@ProductName(m.Product) <span class="badge badge-outline uppercase">@m.Language</span></td>
                                <td class="max-w-xs"><p class="truncate" title="@m.Subject">@m.Subject</p></td>
                                <td class="whitespace-nowrap">
                                    <span class="font-medium">@m.Sent / @m.Total</span> sent
                                    @if (m.Pending + m.Sending > 0)
                                    {
                                        <span class="badge badge-secondary ml-1">@(m.Pending + m.Sending) waiting</span>
                                    }
                                    @if (m.Failed > 0)
                                    {
                                        <span class="badge badge-destructive ml-1">@m.Failed failed</span>
                                    }
                                </td>
                                <td class="text-right whitespace-nowrap">
                                    @if (m.Failed > 0)
                                    {
                                        <button type="button" class="btn btn-outline btn-sm" disabled="@_busy" @onclick="() => RetryAsync(mailing)">Send failed again</button>
                                    }
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => OpenRecipientsAsync(mailing)">Addresses</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (_confirm && _selected is not null)
{
    <Modal Title="@($"Send {Addresses.Count} {(Addresses.Count == 1 ? "e-mail" : "e-mails")}?")"
           Description="Each address gets its own e-mail with only itself in To." OnClose="() => _confirm = false">
        <div class="space-y-4 text-sm">
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5">
                <dt class="text-muted-foreground">From</dt><dd>@Smtp.Value.FromName &lt;@Smtp.Value.FromAddress&gt;</dd>
                <dt class="text-muted-foreground">Template</dt><dd>@ProductName(_selected.Product) · @_selected.Language?.ToUpperInvariant()</dd>
                <dt class="text-muted-foreground">Subject</dt><dd>@_subject</dd>
                <dt class="text-muted-foreground">Addresses</dt><dd>@Addresses.Count@(_skipContacted ? " - those already contacted are skipped" : "")</dd>
            </dl>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" class="btn btn-outline" @onclick="() => _confirm = false">Cancel</button>
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SendAsync"><Icon Name="mail" Class="size-4" /> Send</button>
            </div>
        </div>
    </Modal>
}

@if (_recipientsOf is not null)
{
    <Modal Title="Addresses" Description="@_recipientsOf.Subject" OnClose="() => _recipientsOf = null">
        @if (_recipients is null)
        {
            <div class="h-24 animate-pulse rounded-xl bg-muted"></div>
        }
        else
        {
            <ul class="divide-y divide-border text-sm">
                @foreach (var r in _recipients)
                {
                    <li class="flex items-start justify-between gap-3 py-2" data-email="@r.Email">
                        <div class="min-w-0">
                            <p class="truncate font-mono text-xs">@r.Email</p>
                            @if (!string.IsNullOrEmpty(r.LastError))
                            {
                                <p class="text-xs break-words text-destructive">@r.LastError</p>
                            }
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="@StatusBadge(r.Status)">@r.Status</span>
                            @if (r.SentAt is not null)
                            {
                                <p class="text-xs text-muted-foreground">@Labels.DateTime(r.SentAt)</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </Modal>
}

@code {
    private const string AddressesExample = "ann@example.com\nbob@example.com";

    // A loose check for the page; the API decides (CreateMailing, marketing.email_invalid).
    private static readonly Regex Email = new(
        @"^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
        RegexOptions.CultureInvariant
    );

    private List<MarketingTemplatesRow>? _templates;
    private List<MarketingMailingsRow>? _mailings;
    private MarketingTemplatesRow? _selected;
    private string _subject = "";
    private string _body = "";
    private string _emails = "";
    private bool _skipContacted = true;
    private bool _confirm;
    private bool _busy;
    private string? _error;
    private string? _formError;
    private string? _notice;
    private MarketingMailingsRow? _recipientsOf;
    private List<MarketingRecipientsRow>? _recipients;
    private PeriodicTimer? _timer;
    private Task? _refresh;

    // A new id per attempt to send (ADR 0006): a double click or a retry of the same attempt queues nothing twice.
    private Guid _mailingId = Guid.CreateVersion7();

    private List<string> Tokens =>
        Regex.Split(_emails, @"[\s,;]+").Select(e => e.Trim().ToLowerInvariant()).Where(e => e.Length > 0).ToList();

    private List<string> Addresses => Tokens.Distinct().ToList();
    private int Duplicates => Tokens.Count - Addresses.Count;
    private List<string> Invalid => Addresses.Where(e => !Email.IsMatch(e)).ToList();

    private bool Edited =>
        _selected is not null && (_subject != _selected.Subject || _body != _selected.Body);

    private static string ProductName(string? product) =>
        product switch
        {
            "great-sso" => "Great SSO",
            _ => product ?? "",
        };

    private static string StatusBadge(string? status) =>
        status switch
        {
            "sent" => "badge badge-success",
            "failed" => "badge badge-destructive",
            _ => "badge badge-secondary",
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAsync();
        await LoadMailingsAsync();
        // While a mailing is going out, its progress follows without a click.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _refresh = RefreshLoopAsync(_timer);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer)
    {
        while (await timer.WaitForNextTickAsync())
        {
            if (_mailings?.Any(m => m.Pending + m.Sending > 0) != true)
                continue;
            await InvokeAsync(async () =>
            {
                await LoadMailingsAsync();
                StateHasChanged();
            });
        }
    }

    private async Task LoadTemplatesAsync()
    {
        try
        {
            _templates = (await Api.Api.Marketing.Templates.GetAsync(r =>
            {
                r.QueryParameters.Sort = TemplatesApi.GetSortQueryParameterType.Code;
                r.QueryParameters.PageSize = 50;
            }))?.Items ?? [];
            if (_selected is not null)
                _selected = _templates.FirstOrDefault(t => t.Id == _selected.Id);
        }
        catch (Exception ex)
        {
            Fail(ex, e => _error = e);
        }
    }

    private async Task LoadMailingsAsync()
    {
        try
        {
            _mailings = (await Api.Api.Marketing.Mailings.GetAsync(r =>
            {
                r.QueryParameters.Sort = MailingsApi.GetSortQueryParameterType.CreatedAt;
                r.QueryParameters.Desc = true;
                r.QueryParameters.PageSize = 50;
            }))?.Items ?? [];
        }
        catch (Exception ex)
        {
            Fail(ex, e => _error = e);
        }
    }

    private void Choose(MarketingTemplatesRow template)
    {
        _selected = template;
        _subject = template.Subject ?? "";
        _body = template.Body ?? "";
        _formError = null;
        _notice = null;
    }

    private async Task SaveTemplateAsync()
    {
        if (_selected is null)
            return;
        var request = new MarketingTemplateUpdateRequest
        {
            Id = _selected.Id,
            Subject = _subject,
            Body = _body,
            RowVersion = _selected.RowVersion,
        };
        await RunAsync(async () =>
        {
            await Api.Api.Marketing.TemplateUpdate.PostAsync(request);
            await LoadTemplatesAsync();
            if (_selected is not null)
                Choose(_selected);
            _notice = "The template is saved.";
        });
    }

    private async Task SendAsync()
    {
        if (_selected is null)
            return;
        var product = ProductName(_selected.Product);
        var request = new MarketingMailingCreateRequest
        {
            Id = _mailingId,
            TemplateId = _selected.Id,
            Subject = _subject,
            Body = _body,
            Emails = Addresses,
            SkipContacted = _skipContacted,
        };
        await RunAsync(async () =>
        {
            var result = await Api.Api.Marketing.MailingCreate.PostAsync(request);
            _mailingId = Guid.CreateVersion7();
            _emails = "";
            _notice = result?.Skipped > 0
                ? $"{result.Queued} e-mails are going out; {result.Skipped} skipped - they already got one about {product}."
                : $"{result?.Queued} e-mails are going out, one by one.";
            await LoadMailingsAsync();
        });
        _confirm = false;
    }

    private async Task RetryAsync(MarketingMailingsRow mailing)
    {
        await RunAsync(async () =>
        {
            await Api.Api.Marketing.MailingRetry.PostAsync(new MarketingMailingRetryRequest { Id = mailing.Id });
            await LoadMailingsAsync();
        });
    }

    private async Task OpenRecipientsAsync(MarketingMailingsRow mailing)
    {
        _recipientsOf = mailing;
        _recipients = null;
        try
        {
            var rows = new List<MarketingRecipientsRow>();
            for (var page = 1; ; page++)
            {
                var result = await Api.Api.Marketing.Recipients.GetAsync(r =>
                {
                    r.QueryParameters.MailingId = mailing.Id;
                    r.QueryParameters.Sort = RecipientsApi.GetSortQueryParameterType.Email;
                    r.QueryParameters.PageSize = 200;
                    r.QueryParameters.Page = page;
                });
                rows.AddRange(result?.Items ?? []);
                if (result?.HasMore != true)
                    break;
            }
            _recipients = rows;
        }
        catch (Exception ex)
        {
            _recipientsOf = null;
            Fail(ex, e => _error = e);
        }
    }

    private async Task RunAsync(Func<Task> change)
    {
        _busy = true;
        _formError = null;
        _notice = null;
        try
        {
            await change();
        }
        catch (Exception ex)
        {
            _confirm = false;
            Fail(ex, e => _formError = e);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Fail(Exception ex, Action<string> show)
    {
        if (ApiErrors.IsSessionExpired(ex))
            Navigation.NavigateTo("auth/session-expired?returnUrl=%2Fadmin%2Fmarketing%2Fmail", forceLoad: true);
        show(ApiErrors.Describe(ex));
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_refresh is not null)
            await _refresh.ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
    }
}
