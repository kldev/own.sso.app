<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Great SSO</title>
    <link rel="icon" type="image/svg+xml" href="img/logo.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="icon/favicon.png" />
    <link rel="apple-touch-icon" href="icon/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Sso.Api.styles.css"]" />
    @* Light by default; the choice is kept per browser. *@
    <script>
        (function () {
            try {
                document.documentElement.classList.toggle("dark", localStorage.getItem("sso.theme") === "dark");
            } catch (e) { }
            window.ssoTheme = {
                toggle: function () {
                    var dark = document.documentElement.classList.toggle("dark");
                    try { localStorage.setItem("sso.theme", dark ? "dark" : "light"); } catch (e) { }
                    return dark;
                },
                isDark: function () { return document.documentElement.classList.contains("dark"); }
            };
        })();
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // No prerendering: every page loads its data once, in the circuit, with the signed-in user's token.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    // The sign-in page is static server rendering: it writes the auth cookie, which an interactive circuit cannot.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
