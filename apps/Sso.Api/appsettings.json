{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sso-api",
    "Audience": "sso",
    "Lifetime": "01:00:00"
  },
  "Operator": {
    "Name": "Example Team",
    "Website": "https://example.com",
    "Contact": "hello@example.com"
  },
  "Sessions": {
    "IdleTimeout": "14.00:00:00",
    "AbsoluteLifetime": "30.00:00:00"
  },
  "Smtp": {
    "Port": 587,
    "Security": "StartTls",
    "FromAddress": "hello@example.com",
    "FromName": "Great SSO"
  },
  "Marketing": {
    "PollInterval": "00:00:05",
    "DelayBetweenEmails": "00:00:03",
    "BatchSize": 20,
    "MaxAttempts": 3,
    "RetryAfter": "00:05:00"
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "sso"
  },
  "Seed": {
    "Enabled": true,
    "Demo": true
  },
  "BootstrapAdmin": {
    "Username": "admin",
    "Email": "admin@example.com",
    "DisplayName": "Admin",
    "GithubEmail": "admin@example.com",
    "GoogleEmail": "admin@example.com"
  }
}
