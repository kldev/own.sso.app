<Project Sdk="Microsoft.NET.Sdk">
  <!-- What Liquibase cannot do as sso_migrator (not a superuser, ADR 0004): the migrator's role and the database
       before it, the application roles' logins after it. Run with a superuser connection by
       deploy/deploy.sh and by the tests (ApiFixture), the same code in both. The schema stays Liquibase's (db/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
