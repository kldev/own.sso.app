# Copy to .env (never committed - .gitignore). Read by deploy/deploy.sh; for `dotnet run` put the same values in
# user-secrets (dotnet user-secrets set "Providers:GitHub:ClientId" ... --project apps/Sso.Api).
#
# Nothing here is needed to try Great SSO locally: without a provider the local container runs with the development
# sign-in stub, and the first start seeds the admin admin@example.com and the demo data (ADR 0015, 0018).

# The first admin, entered on the first start of an empty database (defaults: admin / admin@example.com). Set them to
# a real person's provider e-mails before the first start of a real deployment.
BootstrapAdmin__Username=
BootstrapAdmin__Email=
BootstrapAdmin__DisplayName=
BootstrapAdmin__GithubEmail=
BootstrapAdmin__GoogleEmail=
BootstrapAdmin__MicrosoftEmail=
# The demo data (example.com people, applications, sessions, a mailing) with the first admin; false = the admin only.
Seed__Demo=

# Nobody has a password in Great SSO (ADR 0011): people sign in through these providers. A provider is on only when
# both its client id and secret are set; Microsoft also needs at least one allowed organisation (tenant id). Callback
# URLs to register at the providers (locally): http://localhost:6100/signin/github, /signin/google, /signin/microsoft.

# GitHub: Settings -> Developer settings -> OAuth Apps.
Providers__GitHub__ClientId=
Providers__GitHub__ClientSecret=

# Google: Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
Providers__Google__ClientId=
Providers__Google__ClientSecret=

# Microsoft (work accounts only): Entra ID -> App registrations, "Accounts in any organizational directory".
Providers__Microsoft__ClientId=
Providers__Microsoft__ClientSecret=
Providers__Microsoft__AllowedTenantIds__0=
